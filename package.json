{
  "name": "aff-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-dev.mjs && node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\" && next dev -p 3000",
    "dev:9000": "node scripts/prepare-dev.mjs && node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\" && next dev -p 9000",
    "dev:clean": "npm run dev",
    "dev:fresh": "node scripts/kill-dev-port.mjs && npm run dev",
    "build": "node scripts/prepare-dev.mjs && node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\" && next build",
    "build:verify": "node scripts/build-verify.mjs",
    "postbuild": "node -e \"console.log('[aff-site] Before npm run dev, use: npm run dev:clean (avoids 682.js cache errors on Windows).')\"",
    "start": "next start",
    "lint": "next lint",
    "test": "node --require ./scripts/mock-server-only.cjs --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "qa:launch": "npm test && next lint",
    "seo:phase1": "node scripts/seo-phase1.mjs",
    "promos:webp": "node scripts/convert-promo-webp.mjs",
    "deploy:install": "bash deploy/install-server.sh",
    "deploy:update": "bash deploy/update-server.sh",
    "deploy:release": "bash deploy/release-deploy.sh",
    "deploy:rollback": "bash scripts/rollback-release.sh",
    "load:phase-c": "node scripts/load-phase-c.mjs",
    "launch:readiness": "tsx scripts/launch-readiness.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "scan:cta-boundary": "node scripts/scan-client-cta-boundary.mjs",
    "routes:inventory": "node scripts/route-inventory.mjs",
    "validate:release": "tsx scripts/validate-release.ts",
    "validate:release:fast": "tsx scripts/validate-release.ts --skip-build",
    "smoke:staging": "node scripts/smoke-staging.mjs",
    "ops:backup": "node scripts/backup-postgres.mjs",
    "ops:backup-prod": "node scripts/ops/backup-production.mjs",
    "ops:restore-verify": "node scripts/ops/restore-verify.mjs",
    "ops:health-monitor": "node scripts/ops/health-monitor.mjs",
    "ops:migrate-rehearse": "node scripts/rehearse-migrations.mjs",
    "ops:restore-rehearse": "node scripts/restore-rehearsal.mjs",
    "ops:sprint20-preflight": "node scripts/sprint20-preflight.mjs",
    "ops:sprint20-preflight:fast": "node scripts/sprint20-preflight.mjs --skip-build",
    "ops:verify-origin": "node scripts/sprint20-verify-origin.mjs",
    "ops:rollback-rehearse": "node scripts/sprint20-rollback-rehearse.mjs",
    "generate:flag-tints": "node scripts/generate-flag-tints.mjs"
  },
  "dependencies": {
    "@types/pg": "^8.20.0",
    "lucide-react": "^1.26.0",
    "next": "^14.2.35",
    "pg": "^8.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "flag-icons": "^7.5.0",
    "postcss": "8.4.39",
    "sharp": "^0.35.2",
    "tailwindcss": "3.4.6",
    "tsx": "^4.23.1",
    "typescript": "5.5.3"
  }
}
