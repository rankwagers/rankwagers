# Public origin (sitemap, canonical, hreflang, OG). No trailing slash.
# development/test: defaults to http://localhost:3000 when unset
# staging/production: REQUIRED — server refuses to start if missing/invalid
# Forbidden placeholders: example.com, your-domain.com
SITE_URL=https://rankwagers.com
# APP_ENV=development|test|staging|production (optional; defaults from NODE_ENV)
# APP_ENV=staging
# STAGING_NOINDEX=true
# FF_STAGING_BANNER_VISIBLE=true
# FF_SIGNED_REDIRECT_REQUIRED=false
# FF_EMERGENCY_DISABLE_COMBO=false
# FF_EMERGENCY_DISABLE_AFFILIATE=false
# AFFILIATE_REDIRECT_PREVIOUS_SECRET=
# AFFILIATE_REDIRECT_TOKEN_TTL_SECONDS=900
# HSTS_INCLUDE_SUBDOMAINS=false
# HSTS_PRELOAD=false
# INTERNAL_CRON_SECRET=
# NOT: Sunucuda .env.local varsa Next.js onu .env'in ÜZERİNE yazar. Prod'da .env.local içinde
# SITE_URL=http://... bırakmayın (Windows dev kopyası sık hata). Prod için sadece .env yeterli.

# Logo / titles / footer marka adı (opsiyonel; varsayılan RankWagers)
# NEXT_PUBLIC_SITE_NAME=RankWagers

# Telegram bonus kanalı (CTA butonları buraya yönlendirir)
NEXT_PUBLIC_TELEGRAM_URL=

# Live feed — VIP bot deep link (boş bırakılabilir; bot hazır olunca doldur)
NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/rankwagersbot

# (Opsiyonel) Plausible/Umami analytics domain
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Google Tag Manager (tüm sayfalar — root layout)
NEXT_PUBLIC_GTM_ID=GTM-5D4FPZ99

# GA4 ölçüm kimliği — yalnızca GTM içindeki "GA4 Yapılandırma" etiketinde kullanın.
# Siteye gtag.js snippet'i EKLEMEYIN (GTM ile çift sayım). Ayrıntı: docs/ga4-gtm-setup.md
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-089KXEMR0R

# --- Growth measurement (docs/growth-measurement.md) ---
# Consent Mode v2 default: balanced (analytics on, ads off) | strict (all off) | granted (all on)
NEXT_PUBLIC_CONSENT_DEFAULT=balanced
# Search-engine verification (paste the token from each console; meta tag appears when set).
# Google Search Console: content= value of the google-site-verification meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools: content= value of the msvalidate.01 meta tag.
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# (Opsiyonel) Yandex Webmaster verification.
NEXT_PUBLIC_YANDEX_SITE_VERIFICATION=

# Admin paneli erişim anahtarı (/admin?key=...). Mutlaka güçlü bir değer!
ADMIN_KEY=change-this-secret-key

# Signed /go redirect context (staging/production: required, non-default)
# AFFILIATE_REDIRECT_SECRET=

# Developer + /api/*/diagnostics (staging/production)
# Feature flag OFF by default → 404. When enabled, require secret header/query.
# ENABLE_DIAGNOSTICS=false
# DIAGNOSTICS_SECRET=
# DIAGNOSTICS_IP_ALLOWLIST=203.0.113.10

# Analytics: sunucuda data/events.log oluşur (git'e alınmaz). Deploy'da yerel
# data/ klasörünü kopyalamayın — sadece canlı trafik loglanır.

# FootyStats API (server-side only — daily match lists)
FOOTYSTATS_API_KEY=

# API-Football (api-sports.io) — team logos, live scores, World Cup ticker
API_FOOTBALL_KEY=
# Append-only PostgreSQL store for imported API-Football odds history.
# Apply db/migrations/20260724_create_odds_history.sql before enabling.
# ODDS_HISTORY_DATABASE_URL=postgresql://user:password@host:5432/rankwagers
# Attribution / postbacks (defaults to ODDS_HISTORY_DATABASE_URL when unset)
# Apply db/migrations/20260725_create_affiliate_attribution.sql
# ATTRIBUTION_DATABASE_URL=postgresql://user:password@host:5432/rankwagers
# ATTRIBUTION_ADAPTER=memory
# Prepared snapshots (defaults to attribution/odds DB URL)
# SNAPSHOT_DATABASE_URL=postgresql://user:password@host:5432/rankwagers
# SNAPSHOT_ADAPTER=memory
# SNAPSHOT_FRESH_CURRENT_SEC=900
# SNAPSHOT_FRESH_RECENT_SEC=3600
# SNAPSHOT_FRESH_STALE_SEC=21600
# SNAPSHOT_FRESH_EXPIRED_SEC=86400
# Protected cron (POST + x-cron-secret header only)
# ENABLE_CRON=false
# CRON_SECRET=
# JOB_LOCK_ADAPTER=memory
# Evidence Capture & Settlement (Sprint 23B) — flags default OFF; pipeline stays
# dormant until explicitly enabled. See docs/plans/sprint-23b-evidence-capture-settlement.md
# Master flags for the capture / settlement crons+jobs ("true" or "1" to enable)
# EVIDENCE_CAPTURE_ENABLED=false
# EVIDENCE_SETTLEMENT_ENABLED=false
# Pre-kickoff capture window lead, in minutes (positive int; default 60)
# EVIDENCE_CAPTURE_LEAD_MINUTES=60
# Per-run safety cap on fixtures considered (positive int; default 500)
# EVIDENCE_CAPTURE_MAX_FIXTURES=500
# Archive storage adapter: memory | file | postgres (default file / NDJSON)
# EVIDENCE_ARCHIVE_ADAPTER=file
# Persistent shared dir for the NDJSON archive — never release-local.
# Unset → adapter default. Set to a path outside the release dir in prod.
# EVIDENCE_ARCHIVE_DIR=/opt/rankwagers/shared/evidence-archive
# Postgres connection for the evidence adapter (only used when ADAPTER=postgres).
# Apply db/migrations/20260728_create_evidence_archive.sql before enabling.
# EVIDENCE_DATABASE_URL=postgresql://user:password@host:5432/rankwagers
# Provider timeouts (optional overrides)
# PROVIDER_TIMEOUT_ODDS_FETCH_MS=5000
# Optional override (auto-discovered via API if omitted)
# WORLD_CUP_LEAGUE_ID=1
# WORLD_CUP_SEASON=2026


# Coğrafi erişim: tr-only (varsayılan) = sadece TR IP kapalı
# strict = tr-only + VPN/bot sinyali + Türkçe Accept-Language + yabancı IP engeli
# GEO_ACCESS_MODE=tr-only
# GEO_ACCESS_MODE=strict

# Yerel geliştirme: IP ülkesi simülasyonu (middleware locale yönlendirmesi)
# DEV_COUNTRY=BR
