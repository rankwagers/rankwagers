# Telegram Invite / VIP bot (ayrı token — telegram-eng ile karıştırmayın)
TELEGRAM_BOT_TOKEN=

# Mini App / yönlendirme tabanı (https, BotFather Web App domain)
SITE_URL=https://rankwagers.com

# Başvurular bu chat'e kopyalanır (opsiyonel; boş = sadece dosyaya yaz)
ADMIN_NOTIFY_CHAT_ID=

# Hoş geldin metninde promo (opsiyonel)
PROMO_CODE=

# Özel banner PNG/JPG (boş = assets/welcome.png veya otomatik üretim)
